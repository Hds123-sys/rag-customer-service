# ==================== 应用配置 ====================
APP_NAME=智能客服RAG系统
APP_VERSION=2.0.0
DEBUG=True

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000

# ==================== 大模型配置(OpenAI 兼容接口) ====================
API_BASE_URL=https://token.uino.com/v1
API_KEY=your_api_key_here
API_MODEL=deepseek-v4-flash
API_TIMEOUT=120
API_MAX_RETRIES=2

# ==================== 向量化配置 ====================
# local: 内置离线向量化(零依赖, 无需外部服务); openai: 调用 /v1/embeddings(语义效果更好)
# 若所用服务没有 embeddings 模型, 改回 local 即可
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4
# 仅当 EMBEDDING_PROVIDER=openai 时生效, 留空则复用 API_BASE_URL / API_KEY
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# ==================== 向量库配置 ====================
# auto: 优先连接 Qdrant 服务, 失败自动回退到本地向量库(推荐)
# local: 强制使用本地向量库(纯 Python, 数据落盘 backend/data, 无需 Docker)
# qdrant: 强制连接 Qdrant 服务
VECTOR_STORE_MODE=auto
VECTOR_STORE_PATH=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# ==================== 检索配置 ====================
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_RESULTS=4
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
MIN_SCORE=0.05
MIN_TOP_SCORE=0.35

# ==================== 文件上传配置 ====================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# ==================== 对话配置 ====================
MAX_CONTEXT_LENGTH=4000
TEMPERATURE=0.3
CHAT_HISTORY_MAX_TURNS=6
CHAT_SESSION_TTL=3600

# ==================== 数据库配置 ====================
# 默认使用 SQLite(零配置)。使用 MySQL 时改为:
# DATABASE_URL=mysql+pymysql://rag_user:rag_password@localhost:3306/rag_system
DATABASE_URL=sqlite:///./rag_system.db

# ==================== JWT配置 ====================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_CODE_TTL_SECONDS=600

# ==================== CORS配置 ====================
# 多个域名用逗号分隔; * 表示允许所有来源
CORS_ORIGINS=*
# ==================== 限流配置 ====================
# 规则格式: "次数/窗口秒数"; 填 "0/0" 表示不限制
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REGISTER=30/3600
RATE_LIMIT_LOGIN=30/60
RATE_LIMIT_RESET_REQUEST=10/600
RATE_LIMIT_RESET_CONFIRM=20/600
RATE_LIMIT_CHAT=60/60